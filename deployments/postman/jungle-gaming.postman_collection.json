    {
      "name": "5. Isolamento B2B Multitenant (Provider B)",
      "item": [
        {
          "name": "5.1 Bloquear Leitura de Transação do Provider A por Provider B (403)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{providerBToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/providers/provider-a/wagering/transactions/{{externalTxBetId}}",
              "host": ["{{baseUrl}}"],
              "path": ["providers", "provider-a", "wagering", "transactions", "{{externalTxBetId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 403 Forbidden\", function () {",
                  "    pm.response.to.have.status(403);",
                  "});",
                  "pm.test(\"Mensagem proíbe acesso a transações de outros provedores\", function () {",
                  "    const data = pm.response.json();",
                  "    pm.expect(data.error).to.include(\"cannot access transactions for other providers\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "5.2 Bloquear Reversão Indevida da Transação do Provider A por Provider B",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const txId = \"tx-b-illegal-ref-\" + Date.now();",
                  "pm.collectionVariables.set(\"idempotencyKeyIllegalB\", \"provider-b:\" + txId);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Operação não é processada com sucesso por provedor não proprietário\", function () {",
                  "    const data = pm.response.json();",
                  "    pm.expect(data.status).to.not.eql(\"PROCESSED\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{providerBToken}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{idempotencyKeyIllegalB}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"providerId\": \"provider-b\",\n  \"externalTransactionId\": \"tx-illegal-ref-by-b\",\n  \"playerId\": \"{{playerId}}\",\n  \"walletId\": \"{{walletId}}\",\n  \"roundId\": \"round-1\",\n  \"gameId\": \"fortune-tiger\",\n  \"kind\": \"REFUND\",\n  \"money\": { \"amount\": \"25.00\", \"currency\": \"BRL\" },\n  \"referenceExternalTransactionId\": \"{{externalTxBetId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/wagering/transactions",
              "host": ["{{baseUrl}}"],
              "path": ["wagering", "transactions"]
            }
          }
        }
      ]
    },
    {
      "name": "6. Auditoria & Reconciliação (Internal)",
      "item": [
        {
          "name": "6.1 Consulta Paginada do Ledger Imutável",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{internalToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/wallets/{{walletId}}/ledger?limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["wallets", "{{walletId}}", "ledger"],
              "query": [
                { "key": "limit", "value": "10" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Lançamentos do ledger retornados com integridade\", function () {",
                  "    const data = pm.response.json();",
                  "    pm.expect(data.entries).to.be.an(\"array\");",
                  "    pm.expect(data.entries.length).to.be.above(0);",
                  "    data.entries.forEach(entry => {",
                  "        pm.expect(entry.id).to.be.a(\"string\");",
                  "        pm.expect(entry.walletId).to.eql(pm.collectionVariables.get(\"walletId\"));",
                  "        pm.expect([\"CREDIT\", \"DEBIT\"]).to.include(entry.direction);",
                  "    });",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "6.2 Reconciliação Matemática de Saldo",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{internalToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/wallets/{{walletId}}/reconciliation",
              "host": ["{{baseUrl}}"],
              "path": ["wallets", "{{walletId}}", "reconciliation"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Reconciliação consistente com zero divergência\", function () {",
                  "    const data = pm.response.json();",
                  "    pm.expect(data.consistent).to.eql(true);",
                  "    pm.expect(data.difference.amount).to.eql(\"0.00\");",
                  "    pm.expect(data.difference.currency).to.eql(\"BRL\");",
                  "    pm.expect(data.storedBalance.amount).to.eql(\"1050.00\");",
                  "    pm.expect(data.calculatedBalance.amount).to.eql(\"1050.00\");",
                  "    pm.expect(data.checkedEntries).to.be.above(0);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    }
  ],
