{
  "info": {
    "_postman_id": "c1f7b9e0-82a1-4d3e-9082-f54c9d511874",
    "name": "Jungle Gaming — End-to-End Test Suite",
    "description": "Coleção de testes de ponta a ponta para o sistema de processamento distribuído de apostas Jungle Gaming, cobrindo Health Checks, Autenticação Keycloak OIDC, Isolamento de Carteira, Fluxo de Apostas (BET, WIN, LOSS, REFUND, concorrência, idempotência), Isolamento B2B Multitenant e Auditoria/Reconciliação Matemática de Ledger.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Health Checks",
      "item": [
        {
          "name": "1.1 Health Live (Liveness)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health/live",
              "host": ["{{baseUrl}}"],
              "path": ["health", "live"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Liveness status is UP\", function () {",
                  "    const data = pm.response.json();",
                  "    pm.expect(data.status).to.eql(\"UP\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "1.2 Health Ready (Readiness DB & SQS)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health/ready",
              "host": ["{{baseUrl}}"],
              "path": ["health", "ready"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Readiness status is UP\", function () {",
                  "    const data = pm.response.json();",
                  "    pm.expect(data.status).to.eql(\"UP\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Autenticação Keycloak (OIDC)",
      "item": [
        {
          "name": "2.1 Obter Token Internal Client",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "grant_type", "value": "client_credentials", "type": "text" },
                { "key": "client_id", "value": "internal", "type": "text" },
                { "key": "client_secret", "value": "internal-secret", "type": "text" }
              ]
            },
            "url": {
              "raw": "{{keycloakUrl}}/realms/jungle-gaming/protocol/openid-connect/token",
              "host": ["{{keycloakUrl}}"],
              "path": ["realms", "jungle-gaming", "protocol", "openid-connect", "token"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Token JWT recebido para client internal\", function () {",
                  "    const data = pm.response.json();",
                  "    pm.expect(data.access_token).to.be.a(\"string\");",
                  "    pm.collectionVariables.set(\"internalToken\", data.access_token);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "2.2 Obter Token Provider A",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "grant_type", "value": "client_credentials", "type": "text" },
                { "key": "client_id", "value": "provider-a", "type": "text" },
                { "key": "client_secret", "value": "provider-a-secret", "type": "text" }
              ]
            },
            "url": {
              "raw": "{{keycloakUrl}}/realms/jungle-gaming/protocol/openid-connect/token",
              "host": ["{{keycloakUrl}}"],
              "path": ["realms", "jungle-gaming", "protocol", "openid-connect", "token"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Token JWT recebido para provider-a\", function () {",
                  "    const data = pm.response.json();",
                  "    pm.expect(data.access_token).to.be.a(\"string\");",
                  "    pm.collectionVariables.set(\"providerAToken\", data.access_token);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "2.3 Obter Token Provider B",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "grant_type", "value": "client_credentials", "type": "text" },
                { "key": "client_id", "value": "provider-b", "type": "text" },
                { "key": "client_secret", "value": "provider-b-secret", "type": "text" }
              ]
            },
            "url": {
              "raw": "{{keycloakUrl}}/realms/jungle-gaming/protocol/openid-connect/token",
