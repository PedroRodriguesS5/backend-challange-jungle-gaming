    {
      "name": "3. Isolamento de Carteira",
      "item": [
        {
          "name": "3.1 Bloquear Criação de Carteira por Provedor Externo (403)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{providerAToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"playerId\": \"unauthorized-player-1\",\n  \"initialBalance\": { \"amount\": \"100.00\", \"currency\": \"BRL\" }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/wallets",
              "host": ["{{baseUrl}}"],
              "path": ["wallets"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 403 Forbidden\", function () {",
                  "    pm.response.to.have.status(403);",
                  "});",
                  "pm.test(\"Mensagem de erro restringe operacoes a internal\", function () {",
                  "    const data = pm.response.json();",
                  "    pm.expect(data.error).to.include(\"restricted to internal service\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "3.2 Criação Válida de Carteira com Serviço Interno (201)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const pid = \"player-\" + Date.now();",
                  "pm.collectionVariables.set(\"playerId\", pid);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"Carteira criada com saldo 1000.00 BRL e versao 1\", function () {",
                  "    const data = pm.response.json();",
                  "    pm.expect(data.id).to.be.a(\"string\");",
                  "    pm.expect(data.playerId).to.eql(pm.collectionVariables.get(\"playerId\"));",
                  "    pm.expect(data.balance.amount).to.eql(\"1000.00\");",
                  "    pm.expect(data.balance.currency).to.eql(\"BRL\");",
                  "    pm.expect(data.version).to.eql(1);",
                  "    pm.collectionVariables.set(\"walletId\", data.id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{internalToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"playerId\": \"{{playerId}}\",\n  \"initialBalance\": { \"amount\": \"1000.00\", \"currency\": \"BRL\" }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/wallets",
              "host": ["{{baseUrl}}"],
              "path": ["wallets"]
            }
          }
        }
      ]
    },
    {
      "name": "4. Fluxo de Apostas (Provider A)",
      "item": [
        {
          "name": "4.1 BET 25.00 BRL (Original)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const txId = \"tx-bet-\" + Date.now();",
                  "pm.collectionVariables.set(\"externalTxBetId\", txId);",
                  "pm.collectionVariables.set(\"idempotencyKeyBet\", \"provider-a:\" + txId);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Aposta processada com sucesso, saldo 975.00 BRL\", function () {",
                  "    const data = pm.response.json();",
                  "    pm.expect(data.status).to.eql(\"PROCESSED\");",
                  "    pm.expect(data.balance.amount).to.eql(\"975.00\");",
                  "    pm.expect(data.idempotentReplay).to.eql(false);",
                  "    pm.expect(data.transactionId).to.be.a(\"string\");",
                  "    pm.collectionVariables.set(\"internalTxBetId\", data.transactionId);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{providerAToken}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{idempotencyKeyBet}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"providerId\": \"provider-a\",\n  \"externalTransactionId\": \"{{externalTxBetId}}\",\n  \"playerId\": \"{{playerId}}\",\n  \"walletId\": \"{{walletId}}\",\n  \"roundId\": \"round-1\",\n  \"gameId\": \"fortune-tiger\",\n  \"kind\": \"BET\",\n  \"money\": { \"amount\": \"25.00\", \"currency\": \"BRL\" }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/wagering/transactions",
              "host": ["{{baseUrl}}"],
              "path": ["wagering", "transactions"]
            }
          }
        },
        {
          "name": "4.2 Replay Idêntico da Mesma BET",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Idempotent replay retorna saldo historico original de 975.00 BRL\", function () {",
                  "    const data = pm.response.json();",
                  "    pm.expect(data.status).to.eql(\"PROCESSED\");",
                  "    pm.expect(data.balance.amount).to.eql(\"975.00\");",
                  "    pm.expect(data.idempotentReplay).to.eql(true);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{providerAToken}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{idempotencyKeyBet}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"providerId\": \"provider-a\",\n  \"externalTransactionId\": \"{{externalTxBetId}}\",\n  \"playerId\": \"{{playerId}}\",\n  \"walletId\": \"{{walletId}}\",\n  \"roundId\": \"round-1\",\n  \"gameId\": \"fortune-tiger\",\n  \"kind\": \"BET\",\n  \"money\": { \"amount\": \"25.00\", \"currency\": \"BRL\" }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/wagering/transactions",
              "host": ["{{baseUrl}}"],
              "path": ["wagering", "transactions"]
            }
          }
        },
        {
          "name": "4.3 Conflito de Idempotência (Mesma Chave, Valor Divergente 30.00)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 409 Conflict\", function () {",
                  "    pm.response.to.have.status(409);",
                  "});",
                  "pm.test(\"Mensagem acusa conflito de reutilizacao de chave\", function () {",
                  "    const data = pm.response.json();",
                  "    pm.expect(data.error).to.include(\"idempotency key or transaction ID reused with different payload\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{providerAToken}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{idempotencyKeyBet}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"providerId\": \"provider-a\",\n  \"externalTransactionId\": \"{{externalTxBetId}}\",\n  \"playerId\": \"{{playerId}}\",\n  \"walletId\": \"{{walletId}}\",\n  \"roundId\": \"round-1\",\n  \"gameId\": \"fortune-tiger\",\n  \"kind\": \"BET\",\n  \"money\": { \"amount\": \"30.00\", \"currency\": \"BRL\" }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/wagering/transactions",
              "host": ["{{baseUrl}}"],
              "path": ["wagering", "transactions"]
            }
          }
        },
