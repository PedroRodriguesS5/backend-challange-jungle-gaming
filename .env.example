# ==============================================================================
# Jungle Gaming Backend Challenge - Environment Configuration
# ==============================================================================

# Application Port (Host Mapping)
HTTP_PORT=8080

# Database Configuration (PostgreSQL)
# Use localhost for local CLI testing or "postgres" inside Docker
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=jungle_gaming
DATABASE_URL=postgres://postgres:postgres@localhost:5432/jungle_gaming?sslmode=disable

# Goose Migration Configuration
GOOSE_DRIVER=postgres
GOOSE_DBSTRING=postgres://postgres:postgres@localhost:5432/jungle_gaming?sslmode=disable
GOOSE_MIGRATION_DIR=./migrations

# AWS / MiniStack / LocalStack SQS Configuration
# Use localhost:4566 for local CLI testing or "http://ministack:4566" inside Docker
AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_QUEUE_URL=http://localhost:4566/000000000000/wager-transactions.fifo
SQS_DLQ_URL=http://localhost:4566/000000000000/wager-transactions-dlq.fifo
SQS_EVENTS_QUEUE_URL=http://localhost:4566/000000000000/wager-events.fifo

# Keycloak Identity Provider Configuration
# Keycloak maps port 8081 on host -> 8080 internal
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_REALM=jungle-gaming
KEYCLOAK_ISSUER_URL=http://localhost:8081/realms/jungle-gaming

# Pre-configured Keycloak Client Credentials (from deployments/keycloak/realm-export.json)
PROVIDER_A_CLIENT_ID=provider-a
PROVIDER_A_CLIENT_SECRET=provider-a-secret
PROVIDER_B_CLIENT_ID=provider-b
PROVIDER_B_CLIENT_SECRET=provider-b-secret
INTERNAL_CLIENT_ID=internal
INTERNAL_CLIENT_SECRET=internal-secret
